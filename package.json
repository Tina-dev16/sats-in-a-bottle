{
  "name": "sats-in-a-bottle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build --config web/vite.config.js",
