# ---- required in production ---------------------------------------------------
NODE_ENV=production
# 32 random bytes, hex. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in a KMS / secret manager. LOSING THIS KEY MAKES ALL ENCRYPTED MESSAGES UNREADABLE.
SIB_MASTER_KEY=
APP_URL=https://your-domain.example
BTC_NETWORK=mainnet            # mainnet | testnet | signet | regtest
PAYMENT_PROVIDER=              # see docs/PRODUCTION.md — only "mock" is built in (refused on mainnet)
PAYMENT_WEBHOOK_SECRET=        # >= 32 chars; HMAC key shared with your payment provider
SMTP_URL=smtps://user:pass@smtp.example.com
MAIL_FROM="Sats in a Bottle <no-reply@your-domain.example>"
TRUST_PROXY=1                  # number of reverse-proxy hops in front of the app (needed for correct client IPs)

# ---- optional -----------------------------------------------------------------
PORT=3001
DATA_DIR=./data
MAX_SATS=5000000               # per-bottle launch cap (~0.05 BTC). Raise only after an external audit.
MIN_SATS=1000
CLAIM_WINDOW_DAYS=365          # after unlock, sender may reclaim unclaimed sats
